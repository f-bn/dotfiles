{
  "icon_theme": "Colored Zed Icons Theme Dark",
  "ui_font_family": ".ZedSans",
  "ui_font_size": 16.0,
  "buffer_line_height": "standard",
  "buffer_font_family": "Cascadia Mono",
  "buffer_font_size": 16.0,
  "agent": {
    "default_model": {
      "effort": "high",
      "provider": "deepseek",
      "model": "deepseek-v4-flash",
      "enable_thinking": true
    },
    "dock": "right",
    "sidebar_side": "right"
  },
  "project_panel": { 
    "dock": "left"
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark Pro"
  },
  "auto_install_extensions": {
    "ansible": true,
    "colored-zed-icons-theme": true,
    "csv": true,
    "docker-compose": true,
    "dockerfile": true,
    "html": true,
    "ini": true,
    "one-dark-pro": true,
    "sql": true,
    "terraform": true,
    "toml": true,
    "xml": true
  }
}
