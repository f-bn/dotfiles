# - vim -
[vim-plug]
    type = "file"
    url = "https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim"
    targetPath = ".vim/autoload/plug.vim"
    refreshPeriod = "168h"

# - ohmyzsh and plugins -
[oh-my-zsh]
    type = "archive"
    url = "https://github.com/ohmyzsh/ohmyzsh/archive/master.tar.gz"
    targetPath = ".oh-my-zsh"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

[zsh-autosuggestions]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-autosuggestions/archive/master.tar.gz"
    targetPath = ".oh-my-zsh/custom/plugins/zsh-autosuggestions"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

# - Utilities -
[dive]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "wagoodman/dive" "dive_*_linux_amd64.tar.gz" | quote }}
    path = "dive"
    targetPath = ".local/bin/dive"
    executable = true
    refreshPeriod = "168h"

[docker-credential-secretservice]
    type = "file"
    url = {{ gitHubLatestReleaseAssetURL "docker/docker-credential-helpers" "docker-credential-secretservice-v*.linux-amd64" | quote }}
    targetPath = ".local/bin/docker-credential-secretservice"
    executable = true
    refreshPeriod = "168h"

[kafkactl]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "deviceinsight/kafkactl" "kafkactl_*_linux_amd64.tar.gz" | quote }}
    path = "kafkactl"
    targetPath = ".local/bin/kafkactl"
    executable = true
    refreshPeriod = "168h"

[mise]
    type = "file"
    url = {{ gitHubLatestReleaseAssetURL "jdx/mise" "mise-v*-linux-x64" | quote }}
    targetPath = ".local/bin/mise"
    executable = true
    refreshPeriod = "168h"

[mongosh]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "mongodb-js/mongosh" "mongosh-*-linux-x64.tgz" | quote }}
    path = "bin/mongosh"
    targetPath = ".local/bin/mongosh"
    executable = true
    stripComponents = 1
    refreshPeriod = "168h"

{{ if .desktop }}
[scopebuddy]
    type = "archive-file"
    url = "https://github.com/OpenGamingCollective/ScopeBuddy/archive/refs/tags/{{ (gitHubLatestRelease "OpenGamingCollective/ScopeBuddy").TagName }}.tar.gz"
    path = "bin/scopebuddy"
    targetPath = ".local/bin/gamescope-scb"
    executable = true
    stripComponents = 1
    refreshPeriod = "168h"
{{ end }}

[usage]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "jdx/usage" "usage-x86_64-unknown-linux-gnu.tar.gz" | quote }}
    path = "usage"
    targetPath = ".local/bin/usage"
    executable = true
    refreshPeriod = "168h"

[zellij]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "zellij-org/zellij" "zellij-x86_64-unknown-linux-musl.tar.gz" | quote }}
    path = "zellij"
    targetPath = ".local/bin/zellij"
    executable = true
    refreshPeriod = "168h"
