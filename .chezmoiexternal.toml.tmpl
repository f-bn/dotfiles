# - vim -
[vim-plug]
    type = "file"
    url = "https://raw.githubusercontent.com/junegunn/vim-plug/master/plug.vim"
    targetPath = ".vim/autoload/plug.vim"
    refreshPeriod = "168h"

# - ohmyzsh and plugins -
[oh-my-zsh]
    type = "archive"
    url = "https://github.com/ohmyzsh/ohmyzsh/archive/master.tar.gz"
    targetPath = ".oh-my-zsh"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

[zsh-autosuggestions]
    type = "archive"
    url = "https://github.com/zsh-users/zsh-autosuggestions/archive/master.tar.gz"
    targetPath = ".oh-my-zsh/custom/plugins/zsh-autosuggestions"
    exact = true
    stripComponents = 1
    refreshPeriod = "168h"

# - Applications -
[zed]
    type = "archive"
    url = {{ gitHubLatestReleaseAssetURL "zed-industries/zed" "zed-linux-x86_64.tar.gz" | quote }}
    targetPath = ".local"

# - Utilities -
[docker-credential-secretservice]
    type = "file"
    url = {{ gitHubLatestReleaseAssetURL "docker/docker-credential-helpers" "docker-credential-secretservice-v*.linux-amd64" | quote }}
    targetPath = ".local/bin/docker-credential-secretservice"
    executable = true
    refreshPeriod = "168h"

[docker-scout]
    type = "archive-file"
    url = {{ gitHubLatestReleaseAssetURL "docker/scout" "docker-scout_*_linux_amd64.tar.gz" | quote }}
    path = "docker-scout"
    targetPath = ".docker/cli-plugins/docker-scout"
    executable = true
    refreshPeriod = "168h"

[mise]
    type = "file"
    url = {{ gitHubLatestReleaseAssetURL "jdx/mise" "mise-v*-linux-x64" | quote }}
    targetPath = ".local/bin/mise"
    executable = true
    refreshPeriod = "168h"

{{ if .desktop }}
[scopebuddy]
    type = "archive-file"
    url = "https://github.com/OpenGamingCollective/ScopeBuddy/archive/refs/tags/{{ (gitHubLatestRelease "OpenGamingCollective/ScopeBuddy").TagName }}.tar.gz"
    path = "bin/scopebuddy"
    targetPath = ".local/bin/gamescope-scb"
    executable = true
    stripComponents = 1
    refreshPeriod = "168h"
{{ end }}
